# 生产部署环境变量模板: 复制为 .env.prod 后修改
# 使用: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

SECRET_KEY=change-me-to-a-long-random-string
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=graduation123
APP_PORT=8080

# AI 供应商不在这里配置: 后端不读任何 LLM_*/EMBEDDING_*/OLLAMA_* 环境变量。
# 首次登录管理端后到「系统设置 → AI 服务」添加供应商(base_url + api_key),
# 再把 chat / embedding / rerank 三个能力位绑定到具体模型即可; 密钥加密后落库。
