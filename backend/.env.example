# ===== 应用 =====
APP_ENV=dev
APP_NAME=智能毕业设计管理系统
# SECRET_KEY 必填(无默认值), 要求 >= 32 字符且不含示例串, 否则进程启动即失败.
# 生成命令(任选其一):
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 例: SECRET_KEY= replace-me-with-the-generated-value
SECRET_KEY=

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation
MYSQL_PASSWORD=graduation123

# ===== Redis (docker-compose 使用 redis-stack, 支持向量检索) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ===== 文件上传 =====
# 建议填绝对路径(如 /srv/graduation/uploads); 相对路径会锚定到 backend/ 目录并 resolve
UPLOAD_DIR=/absolute/path/to/backend/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== AI 服务(P11: 配置只在「系统设置 → AI 服务」里维护, 本文件不参与) =====
# 供应商(Base URL + API Key)与三个能力位(会话模型/向量模型/精排模型)的绑定
# 全部保存在数据库里, 由管理员在页面上配置, 保存即生效, 无需改环境变量或重启。
#
# 这里只保留运维级开关:
#   AI_TEST_MODE  留空 = 真实模型; mock = 离线模板替身(仅测试); hash = 本地哈希向量替身(仅测试)
#                 非空且 APP_ENV=prod 时启动即报错, 防止把假回答带上生产。
#   本地 ONNX 精排模型目录默认 <backend>/models/bge-reranker-v2-m3(模型文件不入版本库),
#   目录不存在时检索自动跳过后精排, 不影响问答。
AI_TEST_MODE=

# AI 接口每分钟调用上限(系统设置里可覆盖)
AI_RATE_LIMIT_PER_MINUTE=30
