# ===== 应用 =====
APP_ENV=dev
APP_NAME=智能毕业设计管理系统
# SECRET_KEY 必填(无默认值), 要求 >= 32 字符且不含示例串, 否则进程启动即失败.
# 生成命令(任选其一):
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 例: SECRET_KEY= replace-me-with-the-generated-value
SECRET_KEY=

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation
MYSQL_PASSWORD=graduation123

# ===== Redis (docker-compose 使用 redis-stack, 支持向量检索) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ===== 文件上传 =====
# 建议填绝对路径(如 /srv/graduation/uploads); 相对路径会锚定到 backend/ 目录并 resolve
UPLOAD_DIR=/absolute/path/to/backend/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== AI 服务(真实模型, 不再有静默降级的假回答) =====
# 优先级: 系统设置页里的 ai_* 配置 > 本文件 > 代码默认值。
# LLM_PROVIDER / EMBEDDING_PROVIDER 取值:
#   auto   = 有 API Key 走真实 OpenAI 兼容接口; 无 Key 则探本地 ollama; 两者都不可用 -> 50301(明确报错, 不回退 Mock)
#   openai = 强制云端; 缺 Key 时请求返回 50301 并提示去系统设置填写
#   ollama = 强制本地(先 ollama serve, 再 ollama pull)
#   mock / hash = 仅测试替身, APP_ENV=prod 时启动即报错(防误上生产)
# 换供应商只改 BASE_URL: 智谱 https://open.bigmodel.cn/api/paas/v4 | DeepSeek https://api.deepseek.com
#   通义 https://dashscope.aliyuncs.com/compatible-mode/v1 | 本地 ollama http://127.0.0.1:11434/v1
LLM_PROVIDER=auto
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ===== 本地 ollama(可选): 不安装时 auto 会自动跳过, 走云端或报 50301 =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3

# ===== Rerank(交叉编码精排) =====
# auto = 模型目录存在则启用, 缺失则 Noop 降级(按召回顺序直通); onnx = 强制; none = 关闭
# 模型文件不入版本库: 需自行放 model.onnx + tokenizer.json 到 RERANK_MODEL_DIR(默认 <backend>/models/bge-reranker-v2-m3)
RERANK_PROVIDER=auto
RERANK_RECALL=20
RERANK_KEEP=6

# ===== Agent RAG(多步规划/自检/引用核验) =====
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIEVAL_ROUNDS=3

# ===== AI 限流 =====
AI_RATE_LIMIT_PER_MINUTE=30
