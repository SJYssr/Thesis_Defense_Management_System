# ===== 应用 =====
APP_ENV=dev
APP_NAME=智能毕业设计管理系统
# SECRET_KEY 必填(无默认值), 要求 >= 32 字符且不含示例串, 否则进程启动即失败.
# 生成命令(任选其一):
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 例: SECRET_KEY= replace-me-with-the-generated-value
SECRET_KEY=

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=graduation_system
MYSQL_USER=graduation
MYSQL_PASSWORD=graduation123

# ===== Redis (docker-compose 使用 redis-stack, 支持向量检索) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ===== 文件上传 =====
# 建议填绝对路径(如 /srv/graduation/uploads); 相对路径会锚定到 backend/ 目录并 resolve
UPLOAD_DIR=/absolute/path/to/backend/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== LLM (OpenAI 兼容接口) =====
# provider: auto=有Key走真实API/无Key走内置Mock | openai=强制真实 | mock=强制离线
# base_url 可切换: 智谱 https://open.bigmodel.cn/api/paas/v4 | DeepSeek https://api.deepseek.com | 通义 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=auto
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ===== Embedding =====
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ===== AI 限流 =====
AI_RATE_LIMIT_PER_MINUTE=30
